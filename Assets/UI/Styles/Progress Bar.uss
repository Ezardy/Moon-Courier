:root {
}

.unity-progress-bar__title-container {
    align-items: center;
}

.unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.463);
}

.unity-progress-bar__title {
    color: rgba(255, 255, 255, 0.604);
    -unity-text-auto-size: best-fit 10px 100px;
    padding-top: 0;
    padding-bottom: 0;
    height: 50%;
    padding-right: 0;
    padding-left: 0;
}

.icon-progress-bar {
    flex-direction: row;
}

.unity-progress-bar__container {
    height: 100%;
    max-height: 100%;
    min-height: 0%;
}

.icon-progress-bar__icon {
    height: 100%;
    aspect-ratio: 1;
}

.icon-progress-bar__unity-progress-bar {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: center;
    height: 100%;
}
